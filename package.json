{
  "name": "@local/dsh-wallet-hud",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test/render.test.mjs"
  },
  "description": "Sidebar DeepSeek wallet balance for the Harness Web UI",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "wallet",
    "balance"
  ],
  "license": "MIT",
  "author": "gggtmd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gggtmd/dsh-wallet-hud.git"
  },
  "homepage": "https://github.com/gggtmd/dsh-wallet-hud#readme",
  "bugs": {
    "url": "https://github.com/gggtmd/dsh-wallet-hud/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "CHANGELOG.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
